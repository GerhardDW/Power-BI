	column 'Average Item Price' =
			
			//second dax calculatoin
			DIVIDE(
			    'Fact Sale'[Total Including Tax],
			    'Fact Sale'[Quantity]
			)
		lineageTag: 81232b24-ab6a-46d1-bd7e-d2241eac560f
		summarizeBy: sum

